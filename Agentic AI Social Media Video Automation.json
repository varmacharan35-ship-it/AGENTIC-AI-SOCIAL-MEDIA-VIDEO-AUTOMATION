    {
      "parameters": {
        "jsCode": "const scenes = $input.first().json.output.scenes || [];\nconst voice = \"Matthew\";\nconst audioClips = [];\nconst imageClips = [];\nconst captionClips = [];\nscenes.forEach((s, i) => {\n  const alias = \"scene\" + i;\n  audioClips.push({ alias: alias, asset: { type: \"text-to-speech\", text: s.narration, voice: voice }, start: i === 0 ? 0 : \"auto\", length: \"auto\" });\n  imageClips.push({ asset: { type: \"text-to-image\", prompt: s.visualPrompt, width: 720, height: 1280 }, start: \"alias://\" + alias, length: \"alias://\" + alias, effect: i % 2 === 0 ? \"zoomIn\" : \"zoomOut\" });\n  captionClips.push({ asset: { type: \"rich-caption\", src: \"alias://\" + alias }, start: \"alias://\" + alias, length: \"alias://\" + alias });\n});\nconst renderBody = {\n  timeline: { tracks: [ { clips: captionClips }, { clips: imageClips }, { clips: audioClips } ] },\n  output: { format: \"mp4\", size: { width: 720, height: 1280 } }\n};\nreturn [{ json: { renderBody: renderBody, sceneCount: scenes.length } }];"
      },
